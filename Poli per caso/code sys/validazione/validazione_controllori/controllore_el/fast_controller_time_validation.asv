

%%
%per Windows
%run('..\..\..\Model_Parameter.m')

%per Mac
run('../../../Model_Parameter.m')
addpath('../../../function/')
add_data('../../../data/test_controllore/controllore_el/controllore_veloce/step_test/25_03_2025');

% add_data('../../data/Step Test/Step Test with ball');
% add_data('../../data/Step Test/18_03_2025_v2/without ball');
% add_data('../../data/Step Test/18_03_2025_v2/with ball');
% add_data('../../data/Step Test/18_03_2024/without_ball');
% add_data('../../data/Step Test/18_03_2024/with_ball');

%% controllore del circuito elettrico

s = tf('s');
polo = Rtot/Lc;
tau = 1/polo;
sys = tf(1, [Lc Rtot]);

%% primo test: wc=130rad;pm=80,
kp = 46.0161;
ki = 2117.9265;
kd = 0;


controller = kp + ki/s+ kd*s;

sys_cl = feedback(controller*sys, 1);
%% Plot per 6V
% Parametri temporali
dt = 0.002;  % intervallo di tempo (2 ms)
T = size(C_el_10V(1,:),2);  % numero di campioni nei dati sperimentali
t = (T-1)*0.002;  % vettore temporale basato sui campioni e il passo temporale


% Plot
figure()
hold on
plot(C_el_10V(1,:), C_el_10V(3, :), 'b', 'DisplayName', 'Sperimentale')
plot(out.tout', out.Modello', 'r--', 'DisplayName', 'Modello teorico')
grid on
xlabel('Tempo [s]')
ylabel('Corrente [A]')
title('Current (10V)')
legend
hold off



