clear all
close all
clc

add_data_volt('/data/Step Test/Step Test without ball');
% Calcolo offset misura di corrente (valori senza palla e quando tensione
% nulla (primo secondo di ogni test, ovvero primi 500 dati)
offset_corrente_volt1 = mean(Test_wb_0V(3,:));

offset_corrente_volt2 = mean([Test_wb_12V(3,1:500), Test_wb_15V(3,1:500), Test_wb_18V(3,1:500), Test_wb_21V(3,1:500), Test_wb_23V(3,1:500), ...
    Test_wb_3V(3,1:500), Test_wb_6V(3,1:500), Test_wb_9V(3,1:500)], 'all');




add_data_volt('/data/Step Test/Step Test with ball');

% Calcolo offset sensore di posizione (con la pallina e per i test dove non si alza)
offset_posizione_volt1 = mean(Test_0V(2,:));
offset_posizione_volt2 = mean([Test_12V(2,:), Test_15V(2,:), Test_18V(2,:), Test_19V(2,:), Test_20_5V(2,:), Test_20V(2,:),...
    Test_3V(2,:), Test_6V(2,:), Test_9V(2,:)], 'all');

% Calcolo di kb in modo che quando tocchi il fondo sia a 0.0086 m
media_21V = mean(Test_21V(2,(end-500):end));
media_21V = mean(Test_21V(2,(end-500):end));
media_21V = mean(Test_21V(2,(end-500):end));
media_21V = mean(Test_21V(2,(end-500):end));
media_21V = mean(Test_21V(2,(end-500):end));
media_21V = mean(Test_21V(2,(end-500):end));

media = (mean([Test_21V(2,(end-500):end), Test_21_3V(2,(end-500):end), Test_21_6V(2,(end-500):end), Test_21_9V(2,(end-500):end)], 'all');


Kb = 0.0086 /  (media - offset_posizione_volt2);




plot(Test_0V(1, :), Test_0V(2, :))

plot(Test_19V(1,:), Test_19V(2,:))
close all
